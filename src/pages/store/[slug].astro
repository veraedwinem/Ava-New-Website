---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase } from "../../lib/supabase";

const { slug } = Astro.params;

const { data: book, error } = await supabase
  .from("products")
  .select("*")
  .eq("slug", slug)
  .eq("active", true)
  .single();

if (error || !book) {
  return Astro.redirect("/store");
}

const { data: relatedBooks } = await supabase
  .from("products")
  .select("*")
  .eq("active", true)
  .neq("id", book.id)
  .limit(3);
---

<BaseLayout
  title={`${book.title} - Tienda AVA`}
  description={book.description ?? "Recurso digital de Alianza Vida Abundante para fortalecer tu crecimiento espiritual y ministerial."}
>
  <section class="pt-16 pb-20 bg-white font-serif">
    <div class="container">
      <a
        href="/store"
        class="inline-flex items-center text-sm text-gray-500 hover:text-black transition mb-10"
      >
        ← Volver a la tienda
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="bg-gray-100 rounded-3xl overflow-hidden border border-gray-200">
          {
            book.cover_url ? (
              <img
                src={book.cover_url}
                alt={book.title}
                class="w-full aspect-[4/5] object-cover"
              />
            ) : (
              <div class="aspect-[4/5] flex items-center justify-center text-gray-400">
                Sin portada
              </div>
            )
          }
        </div>

        <div class="lg:pt-8">
          <p class="text-sm uppercase tracking-[0.25em] text-gray-500 mb-4">
            Recurso digital
          </p>

          <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
            {book.title}
          </h1>

          {
            book.description && (
              <p class="text-lg text-gray-600 leading-relaxed mb-8">
                {book.description}
              </p>
            )
          }

          <div class="border-y border-gray-200 py-6 mb-8">
            <p class="text-sm text-gray-500 mb-1">Precio</p>
            <p class="text-3xl font-bold">
              ${Number(book.price).toFixed(2)} MXN
            </p>
          </div>

          <div class="space-y-4 mb-8">
            <button
              class="w-full md:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition"
            >
              Agregar al carrito
            </button>

            <p class="text-sm text-gray-500">
              Recibirás un enlace único de descarga después de completar tu compra.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="rounded-2xl bg-gray-50 border border-gray-200 p-5">
              <p class="font-semibold mb-1">PDF digital</p>
              <p class="text-sm text-gray-500">Disponible después del pago.</p>
            </div>

            <div class="rounded-2xl bg-gray-50 border border-gray-200 p-5">
              <p class="font-semibold mb-1">Licencia única</p>
              <p class="text-sm text-gray-500">Personalizada para tu compra.</p>
            </div>

            <div class="rounded-2xl bg-gray-50 border border-gray-200 p-5">
              <p class="font-semibold mb-1">3 días</p>
              <p class="text-sm text-gray-500">Enlace temporal de descarga.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    relatedBooks && relatedBooks.length > 0 && (
      <section class="py-20 bg-gray-50">
        <div class="container">
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
            <div>
              <p class="text-sm uppercase tracking-[0.25em] text-gray-500 mb-3">
                Más recursos
              </p>
              <h2 class="text-3xl md:text-4xl font-bold">
                Podría interesarte
              </h2>
            </div>

            <a
              href="/store"
              class="text-sm font-medium hover:text-gray-600 transition"
            >
              Ver todos →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              relatedBooks.map((item) => (
                <article class="bg-white rounded-3xl overflow-hidden border border-gray-200 hover:shadow-xl transition-all duration-300">
                  <a href={`/store/${item.slug}`}>
                    <div class="aspect-[4/5] bg-gray-100 overflow-hidden">
                      {
                        item.cover_url ? (
                          <img
                            src={item.cover_url}
                            alt={item.title}
                            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                          />
                        ) : (
                          <div class="w-full h-full flex items-center justify-center text-gray-400">
                            Sin portada
                          </div>
                        )
                      }
                    </div>

                    <div class="p-6">
                      <h3 class="text-xl font-bold mb-3">
                        {item.title}
                      </h3>

                      <p class="text-gray-600 mb-5 line-clamp-2">
                        {item.description}
                      </p>

                      <div class="flex items-center justify-between">
                        <span class="font-bold">
                          ${Number(item.price).toFixed(2)} MXN
                        </span>

                        <span class="text-sm">
                          Ver →
                        </span>
                      </div>
                    </div>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>