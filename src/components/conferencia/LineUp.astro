---
import SpeakerRow from "./SpeakerRow.astro";
import { speakers } from "@/data/fiel/speakers";
---

<section class="bg-fiel-bone py-20 lg:py-32">

  <div class="max-w-[1800px] mx-auto">

    <div class="flex justify-end mb-12 lg:mb-20">

      <h2
        class="
        font-fielHeading
        text-fiel-red
        text-5xl
        tracking-[-0.05em]
        lg:text-9xl
        font-bold pr-4 fade-up"
      >
        Line Up
      </h2>

    </div>

    {
      speakers.map((speaker) => (
        <SpeakerRow speaker={speaker}/>
      ))
    }

  </div>

</section>