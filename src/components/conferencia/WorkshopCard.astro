---
const { workshop, right } = Astro.props;
---

<div
  class:list={[
    "grid grid-cols-[140px_1fr]",
    right
      ? "bg-fiel-rose"
      : "bg-fiel-oliveLight"
  ]}
>

  <img
    src={workshop.image}
    alt=""
    class="
    h-full
    w-full
    object-cover"
  />

  <div class="p-6">

    <span
      class="
      uppercase
      font-bold
      text-sm"
    >
      Taller
    </span>

    <h3
      class="
      mt-2
      uppercase
      font-semibold"
    >
      {workshop.title}
    </h3>

    <p
      class={right ? "text-fiel-red font-semibold" : "text-fiel-olive font-semibold"}
    >
      {workshop.speaker}
    </p>

  </div>

</div>